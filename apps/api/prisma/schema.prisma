// Fase 1 - primeira fatia vertical (GDD secao 25): Empresa -> UnidadeNegocio
// -> Lote, o suficiente para o endpoint de "avancar dia" rodar o
// MotorPostura de verdade (packages/domain) e persistir o resultado.
// Fornecedor, Cliente, Contrato e DocumentoFiscal entram conforme os
// modulos de Compras/Comercial/Fiscal forem implementados na API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Espelha 1:1 o EstadoEmpresa de packages/domain/src/entities/empresa.ts.
// Campos financeiros em Float (nao Decimal) por simplicidade do MVP —
// precisao decimal exata so importa quando o Financeiro/DRE (GDD secao 11.1)
// virar sistema jogavel de verdade; ate la e atrito de tipo sem ganho.
model Empresa {
  id            String   @id @default(cuid())
  nome          String
  fundadaEm     DateTime @default(now())

  caixa         Float    @default(0)
  divida        Float    @default(0)
  limiteCredito Float    @default(0)
  reputacao     Int      @default(40)
  conhecimento  Int      @default(0)
  diaAtual      Int      @default(0)

  unidadesNegocio UnidadeNegocio[]

  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt
}

// Espelha UnidadeNegocio de packages/domain/src/entities/producao.ts.
model UnidadeNegocio {
  id             String  @id @default(cuid())
  empresaId      String
  empresa        Empresa @relation(fields: [empresaId], references: [id])
  nome           String
  /// "matriz" | "poedeira" (packages/domain: UnidadeNegocio["tipo"])
  tipo           String
  capacidadeAves Int

  /// Fornecedor de racao escolhido (GDD secao 11.2) — null ate o jogador decidir; o motor usa um preco de referencia enquanto isso.
  fornecedorRacaoId String?
  fornecedorRacao   Fornecedor? @relation(fields: [fornecedorRacaoId], references: [id])

  lotes     Lote[]
  contratos Contrato[]

  criadaEm DateTime @default(now())
}

// Espelha Fornecedor de packages/domain/src/entities/comercial.ts. Fornecedores
// sao entidades de mercado (nao pertencem a uma empresa) — GDD secao 15.
model Fornecedor {
  id                 String @id @default(cuid())
  nome               String
  precoKgRacao       Float
  /// dias para pagar (0 = a vista) — packages/domain: Fornecedor.prazoPagamentoDias
  prazoPagamentoDias Int
  prazoEntregaDias   Int
  /// 0-100
  confiabilidade     Int

  unidadesAtendidas UnidadeNegocio[]

  criadoEm DateTime @default(now())
}

// Espelha Cliente de packages/domain/src/entities/comercial.ts. Assim como
// Fornecedor, e uma entidade de mercado (GDD secao 14/15), com um perfil de
// oferta fixo (preco/volume/prazo) enquanto nao existe negociacao de verdade.
model Cliente {
  id                 String @id @default(cuid())
  nome               String
  /// 0-100, especifico dessa contraparte (GDD secao 14)
  relacionamento     Int    @default(50)
  confianca          Int    @default(50)
  sensibilidadePreco Int
  prazoMedioDias     Int
  precoOfertadoDuzia Float
  volumeMensalDuzias Int

  contratos Contrato[]
  criadoEm  DateTime   @default(now())
}

// Espelha Contrato de packages/domain/src/entities/comercial.ts. So um
// Contrato "ativo" por UnidadeNegocio de cada vez no MVP — fechar um novo
// desativa o anterior, mesma logica de troca do Fornecedor de racao.
model Contrato {
  id               String         @id @default(cuid())
  clienteId        String
  cliente          Cliente        @relation(fields: [clienteId], references: [id])
  unidadeNegocioId String
  unidadeNegocio   UnidadeNegocio @relation(fields: [unidadeNegocioId], references: [id])

  precoUnitario        Float
  volumeMensalDuzias   Int
  prazoRecebimentoDias Int
  ativo                Boolean @default(true)

  iniciadoEm DateTime @default(now())

  @@index([unidadeNegocioId, ativo])
}

// Espelha LoteProducao de packages/domain/src/entities/producao.ts. Estagio
// (RECRIA/PRODUCAO/...) e derivado de idadeDias em runtime pelo dominio, nao
// persistido — evita o lote e o estagio ficarem dessincronizados no banco.
model Lote {
  id                     String         @id @default(cuid())
  unidadeNegocioId       String
  unidadeNegocio         UnidadeNegocio @relation(fields: [unidadeNegocioId], references: [id])
  /// "branca" | "vermelha" (packages/domain: Linhagem)
  linhagem               String
  quantidadeAvesAlojadas Int
  quantidadeAvesVivas    Int
  idadeDias              Int            @default(0)
  /// Renovar o plantel (Domain Bible secao 2.3) desativa o lote antigo e cria um novo — historico do lote antigo fica preservado.
  ativo                  Boolean        @default(true)

  historico HistoricoProducao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Um registro por dia simulado avancado (GDD secao 9: HistoricoProducao).
// E a base do DRE/relatorios (GDD secao 21.4) — sem isso "Receita/Custos do
// mes" nao existe, so o resultado do ultimo tick.
model HistoricoProducao {
  id     String @id @default(cuid())
  loteId String
  lote   Lote   @relation(fields: [loteId], references: [id])

  /// diaAtual da empresa no momento deste tick (packages/domain: EstadoEmpresa.diaAtual)
  dia              Int
  /// EstagioLote (packages/domain), string por simplicidade do MVP
  estagio          String
  ovosProduzidos   Float
  racaoConsumidaKg Float
  custoRacao       Float
  receitaBruta     Float
  funrural         Float
  custoMaoDeObra   Float
  resultado        Float

  criadoEm DateTime @default(now())

  @@index([loteId, dia])
}

// Espelha DocumentoFiscal de packages/domain/src/fiscal/documentoFiscal.ts.
// Numero e chave sao ficticios/decorativos (o proprio dominio documenta
// isso), mas o numero precisa ser sequencial de verdade por empresa+tipo —
// diferente do NumeradorDocumentoFiscal em memoria do dominio (que reseta a
// cada boot), esta tabela e a fonte da verdade persistida.
model DocumentoFiscal {
  id     String @id @default(cuid())
  empresaId String

  numero Int
  serie  Int    @default(1)
  /// TipoDocumentoFiscal (packages/domain)
  tipo   String
  /// "EMITIDO" | "CANCELADO"
  status String @default("EMITIDO")

  dataEmissao    DateTime @default(now())
  emitenteId     String
  destinatarioId String
  /// ItemDocumentoFiscal[] (packages/domain)
  itens          Json
  valorTotal     Float
  chaveFicticia  String

  /// ReferenciaDocumentoFiscal (packages/domain) achatada em colunas
  transacaoId String
  contratoId  String?
  loteId      String?

  criadoEm DateTime @default(now())

  @@index([empresaId, tipo])
  @@index([empresaId, dataEmissao])
}
