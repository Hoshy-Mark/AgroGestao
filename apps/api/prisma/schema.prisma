// Fase 1 - primeira fatia vertical (GDD secao 25): Empresa -> UnidadeNegocio
// -> Lote, o suficiente para o endpoint de "avancar dia" rodar o
// MotorPostura de verdade (packages/domain) e persistir o resultado.
// Fornecedor, Cliente, Contrato e DocumentoFiscal entram conforme os
// modulos de Compras/Comercial/Fiscal forem implementados na API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Espelha 1:1 o EstadoEmpresa de packages/domain/src/entities/empresa.ts.
// Campos financeiros em Float (nao Decimal) por simplicidade do MVP —
// precisao decimal exata so importa quando o Financeiro/DRE (GDD secao 11.1)
// virar sistema jogavel de verdade; ate la e atrito de tipo sem ganho.
model Empresa {
  id            String   @id @default(cuid())
  nome          String
  fundadaEm     DateTime @default(now())

  caixa         Float    @default(0)
  divida        Float    @default(0)
  limiteCredito Float    @default(0)
  reputacao     Int      @default(40)
  conhecimento  Int      @default(0)
  diaAtual      Int      @default(0)

  unidadesNegocio UnidadeNegocio[]

  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt
}

// Espelha UnidadeNegocio de packages/domain/src/entities/producao.ts.
model UnidadeNegocio {
  id             String  @id @default(cuid())
  empresaId      String
  empresa        Empresa @relation(fields: [empresaId], references: [id])
  nome           String
  /// "matriz" | "poedeira" (packages/domain: UnidadeNegocio["tipo"])
  tipo           String
  capacidadeAves Int

  lotes Lote[]

  criadaEm DateTime @default(now())
}

// Espelha LoteProducao de packages/domain/src/entities/producao.ts. Estagio
// (RECRIA/PRODUCAO/...) e derivado de idadeDias em runtime pelo dominio, nao
// persistido — evita o lote e o estagio ficarem dessincronizados no banco.
model Lote {
  id                     String         @id @default(cuid())
  unidadeNegocioId       String
  unidadeNegocio         UnidadeNegocio @relation(fields: [unidadeNegocioId], references: [id])
  /// "branca" | "vermelha" (packages/domain: Linhagem)
  linhagem               String
  quantidadeAvesAlojadas Int
  quantidadeAvesVivas    Int
  idadeDias              Int            @default(0)

  historico HistoricoProducao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Um registro por dia simulado avancado (GDD secao 9: HistoricoProducao).
// E a base do DRE/relatorios (GDD secao 21.4) — sem isso "Receita/Custos do
// mes" nao existe, so o resultado do ultimo tick.
model HistoricoProducao {
  id     String @id @default(cuid())
  loteId String
  lote   Lote   @relation(fields: [loteId], references: [id])

  /// diaAtual da empresa no momento deste tick (packages/domain: EstadoEmpresa.diaAtual)
  dia              Int
  /// EstagioLote (packages/domain), string por simplicidade do MVP
  estagio          String
  ovosProduzidos   Float
  racaoConsumidaKg Float
  custoRacao       Float
  receitaBruta     Float
  funrural         Float
  custoMaoDeObra   Float
  resultado        Float

  criadoEm DateTime @default(now())

  @@index([loteId, dia])
}
